@page "/"
@using MemoryPalace.Web.Domain.Entities
@using MemoryPalace.Web.Services
@inject ConceptService Concepts
@inject ILogger<Index> Logger

<PageTitle>Memory Palace — Knowledge Atlas</PageTitle>

<div class="mp-shell">
    <aside class="mp-rail">
        <div class="mp-mark">M<span>P</span></div>
        <button class="rail-button active" title="Knowledge map">⌘</button>
        <button class="rail-button" title="Library" @onclick="LoadConcepts">▤</button>
        <div class="rail-spacer"></div>
        <div class="rail-avatar">A</div>
    </aside>

    <main class="mp-main">
        <header class="mp-topbar">
            <div class="crumb">WORKSPACE <span>/</span> PERSONAL KNOWLEDGE</div>
            <div class="top-status"><i></i> LOCAL DATABASE CONNECTED</div>
        </header>

        <section class="mp-heading">
            <div>
                <div class="eyebrow">YOUR SECOND BRAIN, VISUALIZED</div>
                <h1>Knowledge <em>Atlas</em></h1>
                <p class="subtitle">A living map of what you know — and how everything connects.</p>
            </div>
            <button class="primary-action" @onclick="OpenCreate">＋ New concept</button>
        </section>

        <section class="stats-row">
            <div class="stat-card"><span class="stat-label">TOTAL CONCEPTS</span><strong>@concepts.Count.ToString("00")</strong><small>Across your knowledge space</small></div>
            <div class="stat-card"><span class="stat-label">CONNECTIONS</span><strong>@connectionCount.ToString("00")</strong><small>Ideas linked together</small></div>
            <div class="stat-card"><span class="stat-label">CATEGORIES</span><strong>@concepts.Select(x => x.Category).Distinct().Count().ToString("00")</strong><small>Fields of exploration</small></div>
            <div class="stat-card accent-stat"><span class="stat-label">ATLAS STATUS</span><strong>LIVE</strong><small><span class="live-dot"></span> Synced with local storage</small></div>
        </section>

        <section class="workspace-grid">
            <div class="map-panel">
                <div class="panel-head">
                    <div><div class="eyebrow">SPATIAL OVERVIEW</div><h2>Your knowledge map</h2></div>
                    <div class="map-tools"><span class="map-count">@filteredConcepts.Count nodes</span><button class="icon-action" title="Refresh" @onclick="LoadConcepts">↻</button></div>
                </div>
                <div class="map-toolbar">
                    <div class="search-wrap"><span>⌕</span><input placeholder="Search concepts..." @bind="searchTerm" @bind:event="oninput" /></div>
                    <select @bind="selectedCategory"><option value="">All categories</option>@foreach (var category in categories){<option value="@category">@category</option>}</select>
                </div>

                @if (loading)
                {
                    <div class="empty-state"><div class="empty-orbit"></div><p>Mapping your knowledge...</p></div>
                }
                else if (!filteredConcepts.Any())
                {
                    <div class="empty-state">
                        <div class="empty-orbit"><span>✳</span></div>
                        <h3>Your atlas is waiting.</h3>
                        <p>Add your first concept and start connecting ideas.</p>
                        <button class="primary-action" @onclick="OpenCreate">＋ Create first concept</button>
                    </div>
                }
                else
                {
                    <div class="graph-canvas">
                        <svg class="graph-lines" viewBox="0 0 800 460" preserveAspectRatio="none">
                            @foreach (var link in VisibleLinks)
                            {
                                <line x1="@Position(link.SourceConceptId).X" y1="@Position(link.SourceConceptId).Y" x2="@Position(link.TargetConceptId).X" y2="@Position(link.TargetConceptId).Y" class="graph-edge" />
                            }
                        </svg>
                        @foreach (var concept in filteredConcepts.Select((item,index) => new {item,index}))
                        {
                            var pos = NodePosition(concept.index, filteredConcepts.Count);
                            <button class="graph-node @(selectedConcept?.Id == concept.item.Id ? "selected" : "")" style="left:@(pos.X)% ; top:@(pos.Y)%" @onclick="() => SelectConcept(concept.item)">
                                <span class="node-core"></span><span class="node-title">@concept.item.Title</span><span class="node-category">@concept.item.Category</span>
                            </button>
                        }
                    </div>
                }
                <div class="map-legend"><span><i class="legend-node"></i> Concept</span><span><i class="legend-line"></i> Relationship</span><span class="legend-hint">Select a node to explore</span></div>
            </div>

            <aside class="detail-panel">
                @if (selectedConcept is not null)
                {
                    <div class="detail-top"><div class="eyebrow">CONCEPT EXPLORER</div><button class="icon-action danger" title="Delete concept" @onclick="() => DeleteConcept(selectedConcept.Id)">×</button></div>
                    <span class="category-pill">@selectedConcept.Category</span>
                    <h2 class="detail-title">@selectedConcept.Title</h2>
                    <p class="detail-description">@(string.IsNullOrWhiteSpace(selectedConcept.Description) ? "No description yet. Edit this concept to add context." : selectedConcept.Description)</p>
                    <div class="detail-divider"></div>
                    <div class="detail-section-title">CONNECTED IDEAS</div>
                    @if (selectedConcept.OutgoingConnections.Any() || selectedConcept.IncomingConnections.Any())
                    {
                        @foreach (var edge in selectedConcept.OutgoingConnections)
                        {
                            <div class="connection-item"><span class="connection-arrow">↗</span><div><strong>@edge.TargetConcept?.Title</strong><small>@edge.Relationship</small></div></div>
                        }
                        @foreach (var edge in selectedConcept.IncomingConnections)
                        {
                            <div class="connection-item"><span class="connection-arrow">↙</span><div><strong>@edge.SourceConcept?.Title</strong><small>@edge.Relationship</small></div></div>
                        }
                    }
                    else { <p class="muted-note">No connections yet. Link this idea to another concept.</p> }
                    <div class="detail-meta">CREATED @selectedConcept.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy").ToUpperInvariant()</div>
                }
                else
                {
                    <div class="detail-empty"><div class="detail-symbol">◎</div><h3>Explore an idea</h3><p>Select any node on the map to reveal its details and connections.</p></div>
                }
            </aside>
        </section>

        @if (showCreate)
        {
            <div class="modal-backdrop" @onclick="CloseCreate">
                <div class="create-modal" @onclick:stopPropagation="true">
                    <div class="modal-heading"><div><div class="eyebrow">EXPAND YOUR ATLAS</div><h2>New concept</h2></div><button class="icon-action" @onclick="CloseCreate">×</button></div>
                    <label>CONCEPT TITLE</label><input class="form-input" placeholder="e.g. Dark matter" maxlength="100" @bind="newTitle" />
                    <label>DESCRIPTION</label><textarea class="form-input" rows="4" maxlength="2000" placeholder="What is this idea about?" @bind="newDescription"></textarea>
                    <label>CATEGORY</label><input class="form-input" placeholder="e.g. Astrophysics" maxlength="40" @bind="newCategory" />
                    @if (!string.IsNullOrWhiteSpace(errorMessage)){<div class="form-error">@errorMessage</div>}
                    <div class="modal-actions"><button class="secondary-action" @onclick="CloseCreate">Cancel</button><button class="primary-action" @onclick="CreateConcept">Add to atlas ↗</button></div>
                </div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(toastMessage)){<div class="toast">@toastMessage</div>}
        <footer class="mp-footer"><span>MEMORY PALACE <b>·</b> KNOWLEDGE SYSTEM</span><span>BUILT TO CONNECT IDEAS</span></footer>
    </main>
</div>

@code {
    private List<Concept> concepts = new();
    private Concept? selectedConcept;
    private bool loading = true;
    private bool showCreate;
    private string searchTerm = "";
    private string selectedCategory = "";
    private string newTitle = "";
    private string newDescription = "";
    private string newCategory = "General";
    private string errorMessage = "";
    private string toastMessage = "";

    private List<Concept> filteredConcepts => concepts
        .Where(x => string.IsNullOrWhiteSpace(searchTerm) || x.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || x.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .Where(x => string.IsNullOrWhiteSpace(selectedCategory) || x.Category == selectedCategory)
        .ToList();
    private List<string> categories => concepts.Select(x => x.Category).Distinct().OrderBy(x => x).ToList();
    private int connectionCount => concepts.Sum(x => x.OutgoingConnections.Count);
    private IEnumerable<Connection> VisibleLinks => filteredConcepts.SelectMany(x => x.OutgoingConnections).Where(x => filteredConcepts.Any(c => c.Id == x.TargetConceptId));

    protected override async Task OnInitializedAsync() => await LoadConcepts();

    private async Task LoadConcepts()
    {
        loading = true;
        try
        {
            concepts = (await Concepts.GetAllAsync()).ToList();
            if (selectedConcept is not null)
                selectedConcept = await Concepts.GetByIdAsync(selectedConcept.Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load concepts");
            toastMessage = "Could not load concepts. Please refresh the page.";
        }
        finally { loading = false; }
    }

    private async Task SelectConcept(Concept concept) => selectedConcept = await Concepts.GetByIdAsync(concept.Id);
    private void OpenCreate() { newTitle = ""; newDescription = ""; newCategory = "General"; errorMessage = ""; showCreate = true; }
    private void CloseCreate() => showCreate = false;

    private async Task CreateConcept()
    {
        try
        {
            var created = await Concepts.CreateAsync(newTitle, newDescription, newCategory);
            showCreate = false;
            toastMessage = $"“{created.Title}” added to your atlas.";
            await LoadConcepts();
            selectedConcept = await Concepts.GetByIdAsync(created.Id);
        }
        catch (Exception ex) when (ex is ArgumentException || ex is InvalidOperationException)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task DeleteConcept(Guid id)
    {
        try
        {
            await Concepts.DeleteAsync(id);
            selectedConcept = null;
            toastMessage = "Concept removed.";
            await LoadConcepts();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not delete concept");
            toastMessage = "Could not delete this concept.";
        }
    }

    private (double X, double Y) NodePosition(int index, int count)
    {
        var angle = (2 * Math.PI * index / Math.Max(count, 1)) - Math.PI / 2;
        var radius = count == 1 ? 0 : count > 8 ? 34 : 29;
        return (50 + radius * Math.Cos(angle), 50 + radius * Math.Sin(angle));
    }
    private (double X, double Y) Position(Guid id)
    {
        var index = filteredConcepts.FindIndex(x => x.Id == id);
        if (index < 0) return (50,50);
        var p = NodePosition(index, filteredConcepts.Count);
        return (p.X * 8, p.Y * 4.6);
    }
}
